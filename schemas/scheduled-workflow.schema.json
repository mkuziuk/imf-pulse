{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/scheduled-workflow.schema.json",
  "title": "Private resumable scheduled workflow",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "date",
    "created_at",
    "updated_at",
    "status",
    "next_stage",
    "stages",
    "failure",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^scheduled-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date": {"type": "string", "format": "date"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "deferred", "completed", "terminal"]},
    "next_stage": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "enum": [
          "synchronize_base",
          "discover",
          "select",
          "materialize_source",
          "author",
          "validate",
          "publish_local",
          "commit",
          "push",
          "verify_deployment"
        ]}
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "input_sha256", "receipt", "receipt_sha256", "outputs"],
        "properties": {
          "status": {"const": "completed"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "receipt": {"type": "string", "pattern": "^data/automatic/workflow/scheduled-[0-9]{4}-[0-9]{2}-[0-9]{2}/stages/[A-Za-z0-9._-]+\\.json$"},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outputs": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["classification", "code", "stage", "reason", "attempt", "resume_from", "retry_not_before"],
          "properties": {
            "classification": {"enum": ["retryable", "deferred", "terminal"]},
            "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "stage": {"type": "string"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
            "attempt": {"type": "integer", "minimum": 1},
            "resume_from": {"type": "string"},
            "retry_not_before": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "format": "date-time"}
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "outcome": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["published", "no_update", "review_required", "failed"]},
            "reason": {"type": "string", "minLength": 1},
            "commit_sha": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": false
}

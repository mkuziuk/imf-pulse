{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/claim.schema.json",
  "title": "IMF Pulse claim",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "updated_at",
    "normalized_text",
    "statement_kind",
    "evidence_status",
    "scope",
    "assumptions",
    "confidence",
    "evidence"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "normalized_text": {"type": "string", "minLength": 1},
    "statement_kind": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$"},
    "evidence_status": {
      "type": "string",
      "enum": ["proved", "observed", "inferred", "conjectured", "incomplete", "contradicted"]
    },
    "scope": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence.schema.json#/$defs/evidenceReference"}
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/identifier"}
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supersedes": {"$ref": "common.schema.json#/$defs/identifier"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}

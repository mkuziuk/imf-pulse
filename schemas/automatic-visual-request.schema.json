{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/automatic-visual-request.schema.json",
  "title": "Bounded ChatGPT visual-generation request",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "candidate_id",
    "candidate_sha256",
    "source_reference",
    "slug",
    "title",
    "caption",
    "relation_to_report",
    "limitations",
    "prompt"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate-arxiv-[0-9a-f]{20}$"
    },
    "candidate_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "source_reference": {
      "type": "object",
      "required": ["source_id", "source_sha256", "locator"],
      "properties": {
        "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "locator": {"$ref": "evidence.schema.json#/$defs/structuredLocator"}
      },
      "additionalProperties": false
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "Conceptual illustration — not research evidence"
    },
    "relation_to_report": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "prompt": {
      "type": "string",
      "minLength": 80,
      "maxLength": 6000,
      "pattern": "Conceptual illustration — not research evidence"
    }
  },
  "additionalProperties": false
}

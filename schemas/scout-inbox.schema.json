{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/scout-inbox.schema.json",
  "title": "Frozen private scouting inbox",
  "type": "object",
  "required": [
    "schema_version",
    "edition_date",
    "frozen_at",
    "status",
    "submission_refs",
    "candidates",
    "inbox_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "edition_date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "frozen_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {"enum": ["ready", "no_candidates"]},
    "submission_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^data/automatic/scouting/submissions/[0-9]{4}-[0-9]{2}-[0-9]{2}/[A-Za-z0-9._-]+\\.json$"
          },
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "allOf": [
          {"$ref": "scout-submission.schema.json#/$defs/card"},
          {
            "type": "object",
            "required": ["seen_in_slots"],
            "properties": {
              "seen_in_slots": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["morning", "midday", "afternoon", "evening"]
                }
              }
            }
          }
        ]
      }
    },
    "inbox_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/artifact.schema.json",
  "title": "IMF Pulse artifact or artifact manifest",
  "type": "object",
  "required": ["schema_version", "title", "caption", "stable_url", "files"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "artifact_date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "artifact_class": {
      "type": "string",
      "enum": ["scientific_chart", "web_image", "generated_image", "diagram"]
    },
    "artifact_type": {
      "type": "string",
      "enum": ["scientific_chart", "web_image", "generated_image", "diagram"]
    },
    "title": {"type": "string", "minLength": 1},
    "caption": {"type": "string", "minLength": 1},
    "relation_to_report": {"type": "string", "minLength": 1},
    "stable_url": {"$ref": "common.schema.json#/$defs/publicUrlPath"},
    "manifest_url": {"$ref": "common.schema.json#/$defs/publicUrlPath"},
    "spec_url": {"$ref": "common.schema.json#/$defs/publicUrlPath"},
    "rights_status": {"type": "string", "minLength": 1},
    "rights": {
      "type": "object",
      "required": ["status", "may_publish_publicly"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "may_publish_publicly": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "local_display_allowed": {"type": "boolean"},
        "public_deployment_requires_owner_approval": {"type": "boolean"},
        "license": {"type": "string"},
        "creator": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/timestamp"},
            {"$ref": "common.schema.json#/$defs/calendarDate"}
          ]
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "sha256"],
        "properties": {
          "url": {"$ref": "common.schema.json#/$defs/publicUrlPath"},
          "role": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "mime_type": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "allOf": [
          {"anyOf": [{"required": ["role"]}, {"required": ["kind"]}]},
          {"anyOf": [{"required": ["media_type"]}, {"required": ["mime_type"]}]}
        ],
        "additionalProperties": false
      }
    },
    "generator": {
      "type": "object",
      "required": ["deterministic", "path", "version", "source_files_executed"],
      "properties": {
        "deterministic": {"type": "boolean"},
        "language": {"type": "string", "minLength": 1},
        "path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "source_files_executed": {"type": "boolean", "const": false},
        "clock_dependent_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "parameters": {"type": "object", "additionalProperties": true},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "content_sha256", "role", "execution_status", "rights_status", "locators"],
        "properties": {
          "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "path": {"$ref": "common.schema.json#/$defs/relativePath"},
          "relative_path": {"$ref": "common.schema.json#/$defs/relativePath"},
          "local_path": {"$ref": "common.schema.json#/$defs/relativePath"},
          "source_root_alias": {"$ref": "common.schema.json#/$defs/identifier"},
          "role": {"type": "string", "minLength": 1},
          "execution_status": {"type": "string", "minLength": 1},
          "rights_status": {"type": "string", "minLength": 1},
          "locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {"$ref": "evidence.schema.json#/$defs/structuredLocator"}
              ]
            }
          }
        },
        "anyOf": [{"required": ["path"]}, {"required": ["relative_path"]}, {"required": ["local_path"]}],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "statement", "status", "confidence"],
        "properties": {
          "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "statement": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "minLength": 1},
          "locator": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"$ref": "evidence.schema.json#/$defs/structuredLocator"}
            ]
          },
          "source_locator": {"type": "string", "minLength": 1}
        },
        "anyOf": [{"required": ["locator"]}, {"required": ["source_locator"]}],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "array",
      "items": {"$ref": "evidence.schema.json#/$defs/evidenceReference"}
    },
    "related_pulse": {"$ref": "common.schema.json#/$defs/identifier"}
  },
  "allOf": [
    {"anyOf": [{"required": ["id"]}, {"required": ["artifact_id"]}]},
    {"anyOf": [{"required": ["artifact_class"]}, {"required": ["artifact_type"]}]},
    {"anyOf": [{"required": ["rights"]}, {"required": ["rights_status"]}]},
    {
      "if": {
        "anyOf": [
          {"properties": {"artifact_class": {"const": "generated_image"}}, "required": ["artifact_class"]},
          {"properties": {"artifact_type": {"const": "generated_image"}}, "required": ["artifact_type"]}
        ]
      },
      "then": {
        "properties": {
          "caption": {"pattern": "Conceptual illustration — not research evidence"}
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"artifact_class": {"const": "web_image"}}, "required": ["artifact_class"]},
          {"properties": {"artifact_type": {"const": "web_image"}}, "required": ["artifact_type"]}
        ]
      },
      "then": {
        "required": ["rights"],
        "properties": {
          "rights": {"required": ["creator", "source_url", "retrieved_at", "license"]}
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"artifact_class": {"const": "scientific_chart"}}, "required": ["artifact_class"]},
          {"properties": {"artifact_type": {"const": "scientific_chart"}}, "required": ["artifact_type"]}
        ]
      },
      "then": {
        "properties": {
          "files": {
            "allOf": [
              {
                "contains": {
                  "anyOf": [
                    {"properties": {"media_type": {"const": "text/csv"}}, "required": ["media_type"]},
                    {"properties": {"mime_type": {"const": "text/csv"}}, "required": ["mime_type"]}
                  ]
                }
              },
              {
                "contains": {
                  "anyOf": [
                    {"properties": {"media_type": {"const": "application/json"}}, "required": ["media_type"]},
                    {"properties": {"mime_type": {"const": "application/json"}}, "required": ["mime_type"]}
                  ]
                }
              },
              {
                "contains": {
                  "anyOf": [
                    {"properties": {"media_type": {"enum": ["image/svg+xml", "image/png"]}}, "required": ["media_type"]},
                    {"properties": {"mime_type": {"enum": ["image/svg+xml", "image/png"]}}, "required": ["mime_type"]}
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

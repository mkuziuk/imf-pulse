{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/scout-audit-input.schema.json",
  "title": "Immutable Aegis review input",
  "type": "object",
  "required": [
    "schema_version",
    "edition_date",
    "staged_at",
    "status",
    "inbox_path",
    "inbox_sha256",
    "candidates",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "edition_date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "staged_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {"enum": ["ready", "no_candidates"]},
    "inbox_path": {
      "type": "string",
      "pattern": "^data/automatic/scouting/inboxes/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
    },
    "inbox_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "batch_sha256",
          "candidate",
          "luna_card",
          "submission_paths",
          "risk_flags"
        ],
        "properties": {
          "batch_id": {"type": "string", "pattern": "^external-batch-[0-9a-f]{20}$"},
          "batch_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "candidate": {"$ref": "external-candidate.schema.json"},
          "luna_card": {"$ref": "scout-submission.schema.json#/$defs/card"},
          "submission_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^data/automatic/scouting/submissions/[0-9]{4}-[0-9]{2}-[0-9]{2}/[A-Za-z0-9._-]+\\.json$"
            }
          },
          "risk_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "instruction_like_text",
                "non_arxiv_provider",
                "full_text_not_allowlisted",
                "identity_or_provenance_mismatch"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "input_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "additionalProperties": false
}

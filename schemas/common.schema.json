{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/common.schema.json",
  "title": "IMF Pulse common definitions",
  "$defs": {
    "schemaVersion": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
        {"type": "integer", "minimum": 1}
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._:-]*(?:-[a-z0-9._:-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "calendarDate": {
      "type": "string",
      "format": "date"
    },
    "sourceDate": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"}
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "publicUrlPath": {
      "type": "string",
      "pattern": "^/(?!/)[^\\s\\\\?&#%]+(?:/[^\\s\\\\?&#%]+)*$"
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "confidence": {
      "type": "object",
      "required": ["level", "score", "rationale"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "very_high"]
        },
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "entityReference": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["source", "claim", "method", "experiment", "relationship"]
        },
        "id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "sourceRights": {
      "type": "object",
      "required": ["license", "reuse_status", "public_distribution"],
      "properties": {
        "license": {"type": "string", "minLength": 1},
        "reuse_status": {
          "type": "string",
          "enum": ["internal_only", "unknown", "cleared", "restricted", "public_domain", "not_applicable"]
        },
        "public_distribution": {"type": "boolean"},
        "creator": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at": {
          "oneOf": [
            {"$ref": "#/$defs/timestamp"},
            {"$ref": "#/$defs/calendarDate"},
            {"type": "null"}
          ]
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "gateResult": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["passed", "failed", "skipped"]},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"$ref": "#/$defs/timestamp"},
        "details": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/extract.schema.json",
  "title": "IMF Pulse static extract unit",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "source_id",
    "source_sha256",
    "kind",
    "locator",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "kind": {"type": "string", "minLength": 1},
    "locator": {"$ref": "evidence.schema.json#/$defs/structuredLocator"},
    "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "text": {"type": "string"},
    "data": true
  },
  "oneOf": [
    {"required": ["text"], "not": {"required": ["data"]}},
    {"required": ["data"], "not": {"required": ["text"]}}
  ],
  "additionalProperties": false
}

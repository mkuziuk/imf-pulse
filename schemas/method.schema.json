{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/method.schema.json",
  "title": "IMF Pulse method",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "updated_at",
    "name",
    "objective",
    "estimator",
    "kernel",
    "robust_loss",
    "solver",
    "parameters",
    "boundary_behavior",
    "computational_assumptions",
    "evidence"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "name": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "estimator": {"type": "string", "minLength": 1},
    "kernel": {"type": "string", "minLength": 1},
    "robust_loss": {"type": "string", "minLength": 1},
    "solver": {"type": "string", "minLength": 1},
    "parameters": {"type": "object", "additionalProperties": true},
    "boundary_behavior": {"type": "string", "minLength": 1},
    "computational_assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evidence.schema.json#/$defs/evidenceReference"}
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/identifier"}
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/snapshot.schema.json",
  "title": "IMF Pulse immutable source snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "root_id",
    "source_root_hint",
    "config_sha256",
    "manifest_sha256",
    "entries",
    "missing_optional_sources"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "root_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "source_root_hint": {"type": "string"},
    "config_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "relative_path", "snapshot_path", "sha256", "size_bytes", "extractor"],
        "properties": {
          "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "relative_path": {"$ref": "common.schema.json#/$defs/relativePath"},
          "snapshot_path": {"$ref": "common.schema.json#/$defs/relativePath"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "extractor": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "missing_optional_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/identifier"}
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/automatic-pulse-package.schema.json",
  "title": "Fail-closed automatic editorial package",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "article_mode",
    "candidates",
    "editor",
    "sources",
    "knowledge",
    "pulse",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "article_mode": {"type": "string", "enum": ["deep_dive", "synthesis"]},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/candidateBinding"}
    },
    "editor": {
      "type": "object",
      "required": ["mode", "model", "reviewed_at", "rationale"],
      "properties": {
        "mode": {"const": "automatic_fail_closed"},
        "model": {"type": "string", "minLength": 1, "maxLength": 100},
        "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "rationale": {"type": "string", "minLength": 20, "maxLength": 4000}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "source.schema.json"}
    },
    "knowledge": {
      "type": "object",
      "required": ["claims", "methods", "experiments", "relationships"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "claim.schema.json"}
        },
        "methods": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "method.schema.json"}
        },
        "experiments": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "experiment.schema.json"}
        },
        "relationships": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "relationship.schema.json"}
        }
      },
      "additionalProperties": false
    },
    "pulse": {
      "type": "object",
      "required": [
        "title",
        "lead",
        "topics",
        "signals",
        "why_this_matters",
        "unresolved_question",
        "source_citations"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "lead": {"type": "string", "minLength": 1},
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/identifier"}
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/signal"}
        },
        "why_this_matters": {"type": "string", "minLength": 1},
        "unresolved_question": {"type": "string", "minLength": 1},
        "source_citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/sourceCitation"}
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "candidateBinding": {
      "type": "object",
      "required": ["batch_id", "candidate_id", "candidate_sha256"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^external-batch-[0-9a-f]{20}$"},
        "candidate_id": {"type": "string", "pattern": "^candidate-arxiv-[0-9a-f]{20}$"},
        "candidate_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sourceCitation": {
      "type": "object",
      "required": ["source_id", "label", "locator"],
      "properties": {
        "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "label": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind",
        "slug",
        "title",
        "caption",
        "relation_to_report",
        "limitations"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["diagram", "generated_image", "source_figure"]
        },
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "caption": {"type": "string", "minLength": 1, "maxLength": 1000},
        "relation_to_report": {"type": "string", "minLength": 1, "maxLength": 1000},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/edge"}
        },
        "source_path": {
          "type": "string",
          "pattern": "^tmp/automatic-visuals/[a-z0-9][a-z0-9._-]*\\.(?:png|jpg|jpeg)$"
        },
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "media_type": {"type": "string", "enum": ["image/png", "image/jpeg"]},
        "generation": {
          "type": "object",
          "required": [
            "model",
            "prompt",
            "generated_at",
            "source_reference",
            "reproduction_policy"
          ],
          "properties": {
            "model": {"type": "string", "minLength": 1, "maxLength": 100},
            "prompt": {"type": "string", "minLength": 20, "maxLength": 8000},
            "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
            "source_reference": {
              "type": "object",
              "required": ["source_id", "source_sha256", "locator"],
              "properties": {
                "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
                "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                "locator": {"$ref": "evidence.schema.json#/$defs/structuredLocator"}
              },
              "additionalProperties": false
            },
            "reproduction_policy": {
              "const": "scientific-content-faithful_visual-form-original"
            }
          },
          "additionalProperties": false
        },
        "source_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "locator": {"$ref": "evidence.schema.json#/$defs/structuredLocator"},
        "rights": {
          "type": "object",
          "required": [
            "status",
            "license",
            "creator",
            "source_url",
            "retrieved_at",
            "may_publish_publicly",
            "local_display_allowed"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["cleared", "public_domain", "cc_by", "cc_by_sa", "cc0"]
            },
            "license": {"type": "string", "minLength": 1},
            "creator": {"type": "string", "minLength": 1},
            "source_url": {"type": "string", "format": "uri"},
            "retrieved_at": {"$ref": "common.schema.json#/$defs/timestamp"},
            "may_publish_publicly": {"const": true},
            "local_display_allowed": {"const": true}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "diagram"}}},
          "then": {"required": ["nodes", "edges"]}
        },
        {
          "if": {"properties": {"kind": {"const": "generated_image"}}},
          "then": {
            "required": ["source_path", "sha256", "media_type", "generation"],
            "properties": {
              "caption": {"pattern": "Conceptual illustration — not research evidence"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "source_figure"}}},
          "then": {
            "required": [
              "source_path",
              "sha256",
              "media_type",
              "source_id",
              "source_sha256",
              "locator",
              "rights"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "knowledge_id",
        "heading",
        "what_changed",
        "why_it_matters",
        "confidence",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "knowledge_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "heading": {"type": "string", "minLength": 1},
        "what_changed": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "label"],
      "properties": {
        "from": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "to": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

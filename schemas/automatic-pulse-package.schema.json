{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imf-pulse.local/schemas/automatic-pulse-package.schema.json",
  "title": "Fail-closed automatic editorial package",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "candidate",
    "editor",
    "source",
    "knowledge",
    "pulse",
    "diagram"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "candidate": {
      "type": "object",
      "required": ["batch_id", "candidate_id", "candidate_sha256"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^external-batch-[0-9a-f]{20}$"},
        "candidate_id": {"type": "string", "pattern": "^candidate-arxiv-[0-9a-f]{20}$"},
        "candidate_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "required": ["mode", "model", "reviewed_at", "rationale"],
      "properties": {
        "mode": {"const": "automatic_fail_closed"},
        "model": {"type": "string", "minLength": 1, "maxLength": 100},
        "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "rationale": {"type": "string", "minLength": 20, "maxLength": 4000}
      },
      "additionalProperties": false
    },
    "source": {"$ref": "source.schema.json"},
    "knowledge": {
      "type": "object",
      "required": ["claims", "methods", "experiments", "relationships"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "claim.schema.json"}
        },
        "methods": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "method.schema.json"}
        },
        "experiments": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "experiment.schema.json"}
        },
        "relationships": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "relationship.schema.json"}
        }
      },
      "additionalProperties": false
    },
    "pulse": {
      "type": "object",
      "required": [
        "title",
        "lead",
        "topics",
        "signals",
        "why_this_matters",
        "unresolved_question",
        "source_label",
        "source_locator"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "lead": {"type": "string", "minLength": 1},
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/identifier"}
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/signal"}
        },
        "why_this_matters": {"type": "string", "minLength": 1},
        "unresolved_question": {"type": "string", "minLength": 1},
        "source_label": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "required": ["slug", "title", "caption", "nodes", "edges", "limitations"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "caption": {"type": "string", "minLength": 1, "maxLength": 1000},
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/edge"}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "knowledge_id",
        "heading",
        "what_changed",
        "why_it_matters",
        "confidence",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "knowledge_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "heading": {"type": "string", "minLength": 1},
        "what_changed": {"type": "string", "minLength": 1},
        "why_it_matters": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "label"],
      "properties": {
        "from": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "to": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
